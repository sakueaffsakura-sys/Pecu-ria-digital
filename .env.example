# =============================================================================
#  Pecuária Digital — configuração (.env)
# =============================================================================
#  1. Copie este arquivo para ".env" na MESMA pasta (a raiz do site):
#         cp .env.example .env
#  2. Preencha os valores abaixo (principalmente o bloco BANCO DE DADOS).
#  3. Proteja o arquivo:  chmod 640 .env && chown root:www-data .env
#
#  O script deploy/instalar.sh cria o .env sozinho, com uma senha de banco
#  aleatória. Só edite à mão se for instalar sem o script.
#
#  O .env fica FORA da pasta public/, então o navegador nunca consegue abri-lo.
#  NUNCA envie o .env para o GitHub (ele já está no .gitignore).
#  Depois de mudar algo aqui não precisa reiniciar nada: vale no próximo acesso.
#  Detalhes de cada item: docs/CONFIGURACAO.md
# =============================================================================

# ----- Site ------------------------------------------------------------------
APP_NOME="Pecuária Digital"
# Endereço público, sem barra no fim. Com HTTPS use https://
APP_URL=https://seu-dominio.com.br
# true só no seu computador (mostra detalhes de erro). Em produção: false
APP_DEBUG=false
# Fuso usado para "hoje", vencimentos e relatórios
APP_FUSO=America/Sao_Paulo

# ----- Banco de dados (MySQL 8 ou MariaDB 10.5+) -----------------------------
DB_CONEXAO=mysql
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_BANCO=pecuaria
DB_USUARIO=pecuaria
DB_SENHA=troque-esta-senha
# Opcional: conectar pelo socket local em vez de host/porta
# DB_SOCKET=/run/mysqld/mysqld.sock

# ----- E-mail (recuperar senha e avisos) -------------------------------------
# Use o SMTP do seu provedor de e-mail (Gmail com "senha de app", Zoho,
# Hostinger, Brevo, Amazon SES...). Deixe MAIL_HOST vazio para desligar.
MAIL_HOST=
MAIL_PORTA=587
# tls (porta 587) ou ssl (porta 465)
MAIL_SEGURANCA=tls
MAIL_USUARIO=
MAIL_SENHA=
MAIL_REMETENTE=nao-responda@seu-dominio.com.br
MAIL_NOME_REMETENTE="Pecuária Digital"

# ----- Assinatura Premium — Mercado Pago (etapa 4) ---------------------------
# Painel do Mercado Pago > Suas integrações > Credenciais de produção
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Chave secreta das notificações (webhooks)
MERCADOPAGO_WEBHOOK_SECRET=

# ----- Yui, a assistente com IA (etapa 5) ------------------------------------
# Chave da API do provedor de IA. Sem chave, a Yui fica desligada.
IA_CHAVE_API=
IA_MODELO=
IA_URL=
